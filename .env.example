SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

LSE_EMAIL=your-lse-email
LSE_PASSWORD=your-lse-password

GITHUB_TOKEN=
GITHUB_STATUS_TOKEN=
GITHUB_STATUS_REPO=sid-081205/accom-checker
GITHUB_STATUS_BRANCH=status

# Set to false to watch the browser while debugging.
HEADLESS=true

# Set to true if you want an email every time a check sees availability.
SEND_ON_EVERY_HIT=false

# How long the checker waits for Microsoft Authenticator approval.
MFA_WAIT_MS=240000

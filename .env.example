# Copy this file to .env for local runs. Never commit .env or real credentials.
# GitHub Actions and Vercel each need their own copy of the secrets listed below.

# --- SMTP (any provider; required for availability alerts and the daily summary) ---
# Leave EMAIL_FROM empty to send as SMTP_USER. Do not hardcode a personal address
# in source. EMAIL_TO may be a comma-separated list.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
# Optional extra availability-alert recipients (comma-separated). Daily summary
# still goes only to EMAIL_TO.
# EXTRA_AVAILABILITY_EMAIL_TO=

# --- LSE student accommodation portal ---
LSE_EMAIL=
LSE_PASSWORD=
# Base64 of .auth/lse-cookies.json from `npm run login`. Used by GitHub Actions
# to seed a session so the first run is less likely to prompt for MFA.
# LSE_COOKIES_B64=

# --- Checker runtime ---
HEADLESS=true
SEND_ON_EVERY_HIT=true
MFA_WAIT_MS=240000

# --- GitHub (checker writes status.json / events.json / control.json on a data branch) ---
# Local `npm run check` / `npm run summary` can omit these; Actions supplies GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-github-username/your-repo-name
STATUS_BRANCH=status

# --- Dashboard (new Vercel project only) ---
# Create a new Vercel project from the fork. Do not copy these from an old
# deployment or run `vercel link` against a previous project.
# owner/repo of THIS fork. Required. There is no baked-in default.
GITHUB_STATUS_REPO=your-github-username/your-repo-name
GITHUB_STATUS_BRANCH=status
GITHUB_STATUS_DEFAULT_BRANCH=master
# Fine-grained or classic PAT that can read the status branch (contents:read, actions:read).
GITHUB_STATUS_TOKEN=
# PAT that can write the status branch and dispatch workflows (contents:write, actions:write).
GITHUB_STATUS_WRITE_TOKEN=
# Password that unlocks the dashboard UI.
DASHBOARD_PASSWORD=
# Shared secret for /api/cron, /api/summary, and /api/watchdog.
CRON_SECRET=

# --- cron-job.org (external scheduler; do not reuse someone else's job IDs) ---
# API key from https://console.cron-job.org → Settings → API
CRONJOB_API_KEY=
# Job ID of YOUR checker dispatch job, created by scripts/setup-cronjobs.mjs
CRONJOB_CHECKER_JOB_ID=
# Used only by scripts/setup-cronjobs.mjs
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=your-github-username/your-repo-name
# GITHUB_REF=master
# TIMEZONE=Europe/London
# CHECK_INTERVAL_MINUTES=5
# SUMMARY_HOUR=23
# SUMMARY_MINUTE=55

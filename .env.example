SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

LSE_EMAIL=your-lse-email
LSE_PASSWORD=your-lse-password

GITHUB_TOKEN=
GITHUB_STATUS_TOKEN=
GITHUB_STATUS_REPO=sid-081205/accom-checker
GITHUB_STATUS_BRANCH=status

# Dashboard pause/resume controls the cron-job.org checker schedule via its API.
# CRONJOB_API_KEY: from https://console.cron-job.org (Settings -> API).
# CRONJOB_CHECKER_JOB_ID: the cron-job.org job that dispatches check-availability.yml
#   (defaults to 7809757 if unset).
CRONJOB_API_KEY=
CRONJOB_CHECKER_JOB_ID=7809757

# Set to false to watch the browser while debugging.
HEADLESS=true

# Set to true if you want an email every time a check sees availability.
SEND_ON_EVERY_HIT=false

# How long the checker waits for Microsoft Authenticator approval.
MFA_WAIT_MS=240000
